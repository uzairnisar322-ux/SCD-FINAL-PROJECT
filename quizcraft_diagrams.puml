@startuml Component Diagram
' =====================================================================
' 6. COMPONENT DIAGRAM (Straight Lines, Sharp Edges & Dotted Dependencies)
' =====================================================================
!theme carbon-gray
skinparam shadowing false
skinparam linetype ortho

title QuizCraft - High-Level Component Diagram (Orthogonal Layout with Sharp & Dotted Arrows)

package "User Interface (Presentation Layer)" {
  [Glassmorphic HTML/CSS Templates] as view
  [Asynchronous Client Logic (quiz.js)] as script
}

package "Flask Core Application (Controller Layer)" {
  [App Routing Controller (app.py)] as app
  [Access Guards (decorators)] as guards
  [Scoring Engine (quiz_engine.py)] as engine
}

package "Database Handler (Data Access Layer)" {
  [SQLite Connection & Query Helper (database.py)] as database
}

database "Data Storage" {
  [SQLite Database File (quiz.db)] as sqlite
}

' Solid straight lines (-->) for links, dotted arrows (..>) for component dependencies
view --> app : "HTTP requests"
script --> app : "Asynchronous API JSON requests"
app ..> guards : "references (dotted dependency)"
app ..> engine : "references (dotted dependency)"
app ..> database : "references (dotted dependency)"
database ..> sqlite : "queries (dotted dependency)"
app ..> view : "renders (dotted dependency)"
@enduml
